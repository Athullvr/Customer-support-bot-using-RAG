# ==============================================================================
# LLM & Generation Configuration
# ==============================================================================
# OpenAI API Key for response generation (and optionally OpenAI embeddings)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ==============================================================================
# Embedding Model Configuration
# DESIGN CHOICE: Supports both local HuggingFace embeddings (free, zero API cost)
# and OpenAI embeddings (text-embedding-3-small).
# ==============================================================================
# Options: "huggingface" or "openai"
EMBEDDING_PROVIDER=huggingface

# HuggingFace model options: "sentence-transformers/all-MiniLM-L6-v2" (384-dim, fast), "BAAI/bge-small-en-v1.5"
# OpenAI model options: "text-embedding-3-small" (1536-dim)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ==============================================================================
# Typesense Vector & Search Engine Configuration
# ==============================================================================
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_COLLECTION_NAME=customer_support_docs

# ==============================================================================
# Chunking Strategy Configuration
# DESIGN CHOICE: Heading-aware chunking with overlap maintains document context
# without cutting sentences in half.
# ==============================================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ==============================================================================
# Retrieval & RAG Parameters
# ==============================================================================
# Number of relevant chunks retrieved per query
TOP_K=4

# Search Mode: "hybrid" (Vector + BM25 keyword), "vector", or "keyword"
SEARCH_MODE=hybrid

# Hybrid Search Weight: 0.0 (Pure Keyword) to 1.0 (Pure Vector). 0.7 gives 70% vector + 30% BM25.
HYBRID_ALPHA=0.7
